# ==========================================================
# Nagar Drishti — Backend Environment Configuration
# ==========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d

# Supabase & PostgreSQL Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Direct (IPv6) or Pooler (IPv4 compatible):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# n8n Workflow Automation
N8N_WEBHOOK_BASE_URL=https://nagardrishti.app.n8n.cloud/webhook/nagar-drishti
N8N_WEBHOOK_SECRET=your_n8n_shared_secret

# Uploads Configuration
UPLOAD_MAX_SIZE_MB=10
