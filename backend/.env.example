# ==========================================================
# Nagar Drishti — Backend Environment Configuration
# ==========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d

# Supabase & PostgreSQL Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Direct (IPv6) or Pooler (IPv4 compatible):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# n8n Workflow Automation
N8N_WEBHOOK_BASE_URL=https://nagardrishti.app.n8n.cloud/webhook/nagar-drishti
N8N_WEBHOOK_SECRET=your_n8n_shared_secret

# Uploads Configuration
UPLOAD_MAX_SIZE_MB=10

# SLA Escalation & Email Notification (Nodemailer)
# If SMTP_HOST is not provided, emailService falls back safely to test ethereal transport or local console log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Nagar Drishti Escalations" <escalations@nagardrishti.gov.in>
HIGHER_AUTHORITY_EMAIL=admin@nagardrishti.gov.in
